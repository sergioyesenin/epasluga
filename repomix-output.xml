<file path="src/features/notifications/NotificationsPage.tsx">
import { useState } from 'react'
import { EmptyState, ErrorState, SkeletonList } from '../../design-system'
import { useNotifications } from '../../lib/notifications'
import { NotificationCard } from './NotificationCard'

type Box = 'in' | 'arch'
type ViewState = 'idle' | 'loading' | 'error'

export function NotificationsPage() {
  const [box, setBox] = useState<Box>('in')
  const [viewState, setViewState] = useState<ViewState>('idle')
  const { items, archive, unarchive, remove } = useNotifications()

  const rows = items.filter((n) => (box === 'arch' ? n.archived : !n.archived))

  const reload = () => {
    setViewState('loading')
    window.setTimeout(() => setViewState('idle'), 500)
  }

  if (viewState === 'loading') {
    return (
      <div className="max-w-3xl mx-auto pb-12">
        <h1 className="text-3xl font-bold text-navy-deep mb-6">Мои уведомления</h1>
        <SkeletonList rows={4} />
      </div>
    )
  }

  if (viewState === 'error') {
    return (
      <div className="max-w-3xl mx-auto pb-12">
        <h1 className="text-3xl font-bold text-navy-deep mb-6">Мои уведомления</h1>
        <ErrorState onRetry={() => setViewState('idle')} />
      </div>
    )
  }

  return (
    <div className="max-w-3xl mx-auto pb-12">
      <header className="mb-6">
        <h1 className="text-3xl font-bold text-navy-deep mb-2">Мои уведомления</h1>
        <p className="text-muted max-w-2xl">
          Юридически значимые уведомления нельзя удалить — только в архив.
        </p>
      </header>

      <div className="flex items-center gap-2 mb-5">
        <button
          type="button"
          onClick={() => setBox('in')}
          className={`px-5 py-2 rounded-full text-sm font-semibold transition-colors ${
            box === 'in' ? 'bg-navy text-white' : 'bg-white text-navy border border-line hover:border-navy'
          }`}
        >
          Входящие
        </button>
        <button
          type="button"
          onClick={() => setBox('arch')}
          className={`px-5 py-2 rounded-full text-sm font-semibold transition-colors ${
            box === 'arch' ? 'bg-navy text-white' : 'bg-white text-navy border border-line hover:border-navy'
          }`}
        >
          Архив
        </button>
        <button
          type="button"
          onClick={reload}
          className="ml-auto text-xs text-muted underline hover:text-navy"
        >
          Обновить
        </button>
      </div>

      {rows.length > 0 ? (
        <div className="bg-white border border-line rounded-card divide-y divide-line overflow-hidden">
          {rows.map((n) => (
            <NotificationCard
              key={n.id}
              n={n}
              box={box}
              onArchive={() => archive(n.id)}
              onUnarchive={() => unarchive(n.id)}
              onDelete={() => remove(n.id)}
            />
          ))}
        </div>
      ) : (
        <EmptyState
          title={box === 'arch' ? 'Архив пуст' : 'Нет входящих'}
          description={
            box === 'arch'
              ? 'Здесь будут уведомления, которые вы убрали с глаз.'
              : 'Мы пришлём уведомление, когда по заявлению что-то изменится.'
          }
        />
      )}
    </div>
  )
}
</file>

<file path="src/hooks/useBreadcrumbs.ts">
import { useLocation } from 'react-router-dom'
import { services } from '../data/services'
import { categories } from '../data/categories'

export type Crumb = { label: string; href?: string }

export function useBreadcrumbs(): Crumb[] {
  const { pathname, search } = useLocation()
  const params = new URLSearchParams(search)

  const crumbs: Crumb[] = [{ label: 'Главная', href: '/' }]

  if (pathname === '/catalog') {
    const catId = params.get('cat')
    const view = params.get('view')

    if (view === 'favs') {
      crumbs.push({ label: 'Избранные услуги' })
    } else if (catId) {
      const cat = categories.find((c) => c.id === catId)
      crumbs.push({ label: 'Каталог услуг', href: '/catalog?view=list' })
      crumbs.push({ label: cat?.title ?? 'Категория' })
    } else if (view === 'list') {
      crumbs.push({ label: 'Все услуги' })
    } else {
      crumbs.push({ label: 'Каталог услуг' })
    }
  } else if (pathname.startsWith('/service/')) {
    const id = pathname.replace('/service/', '')
    const svc = services.find((s) => s.id === id)
    crumbs.push({ label: 'Каталог услуг', href: '/catalog' })
    if (svc) {
      crumbs.push({
        label: svc.categoryTitle,
        href: `/catalog?cat=${svc.category}&view=list`,
      })
      crumbs.push({ label: svc.shortTitle })
    } else {
      crumbs.push({ label: 'Услуга' })
    }
  } else if (pathname === '/profile') {
    const tab = params.get('tab')
    crumbs.push({ label: 'Личный кабинет', href: '/profile' })
    const tabLabels: Record<string, string> = {
      apps: 'Заявления',
      docs: 'Документы',
      mail: 'Почта',
      repo: 'Репозиторий',
      data: 'Данные',
    }
    if (tab && tabLabels[tab]) crumbs.push({ label: tabLabels[tab] })
  } else if (pathname === '/apps') {
    crumbs.push({ label: 'Личный кабинет', href: '/profile' })
    crumbs.push({ label: 'Заявления' })
  } else if (pathname === '/notifications') {
    crumbs.push({ label: 'Мои уведомления' })
  } else if (pathname.startsWith('/status/')) {
    crumbs.push({ label: 'Личный кабинет', href: '/profile?tab=apps' })
    crumbs.push({ label: 'Статус заявления' })
  } else if (pathname === '/support') {
    crumbs.push({ label: 'Поддержка' })
  } else if (pathname === '/about') {
    crumbs.push({ label: 'О портале' })
  } else if (pathname === '/login') {
    crumbs.push({ label: 'Вход' })
  }

  return crumbs
}
