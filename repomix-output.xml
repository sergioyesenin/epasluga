        variant === 'need-id' && 'bg-[#fdecea] text-danger',
        variant === 'ecp' && 'bg-[#fff4e5] text-accent-warm',
        variant === 'code' && 'bg-soft text-muted font-semibold normal-case tracking-normal',
        variant === 'accent' && 'bg-[#e7f6f2] text-accent',
        className,
      )}
      {...props}
