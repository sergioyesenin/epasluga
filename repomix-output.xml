def category_for(code: str, situations: list[str], title: str, official: str) -> str:
    """Повторяет legacy serviceCategory() — классификация по ситуациям и ключевым словам."""
    t = f"{title} {official} {code}".lower()

    if "ip" in situations or any(w in t for w in ["патент", "товарн", "изобрет", "полезн", "бренд", "селекц"]):
        if any(w in t for w in ["сорт расте", "животн", "стада", "селекц"]):
            return "agro"
        return "ip"
    if "transport" in situations or any(w in t for w in ["гибдд", "пдд", "vin", "автомоб", "транспорт", "водитель", "гаи"]):
        return "gai"
    if "customs" in situations or any(w in t for w in ["тамож", "погран"]):
        return "border"
    if "health" in situations or any(w in t for w in ["медицин", "больнич", "здоров"]):
        return "health"
    if "study" in situations or any(w in t for w in ["образован", "садик", "стипенд", "талантлив"]):
        return "edu"
    if any(w in t for w in ["виз", "приглашен", "временн(ое|ого) прожив", "пересечен"]):
        return "visa"
    if any(w in t for w in ["паспорт", "гражданств", "id-карт", "удостовер.*личн", "регистрац.*населен"]) and "авто" not in t and "транспорт" not in t:
        return "passport"
    if "family" in situations or any(w in t for w in ["пособи", "дете", "семь", "многодетн", "захоронен"]):
        return "family"
    if "housing" in situations or any(w in t for w in ["жил", "земел", "недвижим", "кадастр"]):
        return "land"
    if "work" in situations and "tax" not in situations:
        return "work"
    if any(w in t for w in ["радио", "частот", "интернет"]):
        return "internet"
    if any(w in t for w in ["квитанц", "дtc", "дтс", "подлинност.*эд", "электронн.*документ"]):
        return "edo"
    if any(w in t for w in ["лиценз", "адвокат", "оруж"]) or "business" in situations:
        return "license"
    if any(w in t for w in ["правонаруш", "судим", "банкрот", "исполнител", "приказн"]) or "army" in situations:
        return "law"
    if "tax" in situations or "pension" in situations or any(w in t for w in ["налог", "доход", "пенс", "торгов"]):
        return "finance"
    return "documents"

def main():
    seen = set()
    services = []
    categories_by_id = {c["id"]: c["title"] for c in CATEGORIES}

    for row in RAW:
        code, title, official, sits, ecp, no_id, org, term, cost, fmt = row
        if code in seen:
            continue
        seen.add(code)
        slug = code.replace("/", "-").replace(" ", "").replace(".", "-")

        cat_id = category_for(code, sits, title, official)
        auth_level = "ecp" if ecp else ("none" if no_id else "id")

        services.append({
            "id": slug,
            "code": code,
            "shortTitle": SHORT.get(code, title),
            "officialTitle": official,
            "plainDescription": PLAIN.get(code, official[:140] + ("…" if len(official) > 140 else "")),
            "official": official,
            "category": cat_id,
            "categoryTitle": categories_by_id.get(cat_id, "Документы"),
            "situations": sits,
            "authLevel": auth_level,
            "timeToComplete": term,
            "cost": cost,
            "format": fmt,
            "orgName": ORGS[org]["name"],
            "orgUnp": ORGS[org]["unp"],
            "steps": [
                "Проверьте данные — они подтянутся из реестров.",
                "Заполните форму. Черновик сохраняется автоматически.",
                "Подпишите заявление и отправьте. Статус — в «Моих услугах».",
            ],
        })

    # Экспорт в TypeScript
    out_dir = Path(__file__).parent.parent / "src" / "data"
    out_dir.mkdir(parents=True, exist_ok=True)

    def ts_array(name: str, items: list, indent: str = "  ") -> str:
        body = json.dumps(items, ensure_ascii=False, indent=2)
        # json.dumps даёт 2 пробела, оставляем как есть
        return f"export const {name} = {body} as const\n"

    (out_dir / "services.ts").write_text(
        "import type { Service } from '../types/service'\n\n"
        "// Сгенерировано legacy/generate_data.py — не редактировать вручную\n"
        "export const services: Service[] = "
        + json.dumps(services, ensure_ascii=False, indent=2)
        + "\n",
        encoding="utf-8",
    )

    (out_dir / "categories.ts").write_text(
        "import type { Category } from '../types/service'\n\n"
        "export const categories: Category[] = "
        + json.dumps(CATEGORIES, ensure_ascii=False, indent=2)
        + "\n",
        encoding="utf-8",
    )

    (out_dir / "situations.ts").write_text(
        "import type { Situation } from '../types/service'\n\n"
        "export const situations: Situation[] = "
        + json.dumps(SITUATIONS, ensure_ascii=False, indent=2)
        + "\n",
        encoding="utf-8",
    )

    (out_dir / "synonyms.ts").write_text(
        "// Синонимы для поиска: пользователь вводит «авто» — находим услуги с VIN и правами\n"
        "export const synonyms: Record<string, string[]> = "
        + json.dumps(SYNONYMS, ensure_ascii=False, indent=2)
        + "\n",
        encoding="utf-8",
    )

    print(f"wrote {len(services)} services src/data/")


if __name__ == "__main__":
    main()
</file>

