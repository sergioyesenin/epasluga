.page {
  flex: 1;
  padding: 28px 36px 56px;
  max-width: none;
  width: 100%;
}

h1 {
  font-size: 30px;
  font-weight: 700;
  color: var(--navy-deep);
  margin: 0 0 8px;
  letter-spacing: -0.02em;
}
.lead {
  color: var(--muted);
  margin: 0 0 20px;
  max-width: 640px;
  font-size: 16px;
}
.page-head {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-start;
  margin-bottom: 8px;
}

.who-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 12px 14px;
  text-decoration: none;
  color: inherit;
  min-width: 260px;
  box-shadow: var(--shadow);
}
.who-card:hover {
  border-color: var(--navy);
}
.who-card b {
  display: block;
}
.who-card span {
  color: var(--muted);
  font-size: 12.5px;
}
.tint-navy {
  background: #e8eeff;
  color: var(--navy);
}
.tint-amber {
  background: #fff4e5;
  color: #9a6700;
}
.tint-teal {
  background: #e7f6f2;
  color: #0f766e;
}
.tint-slate {
  background: #eef0f8;
  color: var(--navy-deep);
}
.tint-violet {
  background: #f3e8ff;
  color: #6d28d9;
}

.search-hero {
  position: relative;
  margin: 8px 0 22px;
  max-width: 760px;
}
.search-hero input,
.toolbar input {
  width: 100%;
  height: 52px;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 0 48px 0 18px;
  font-size: 16px;
  font-family: inherit;
  outline: none;
  background: #fff;
  box-shadow: var(--shadow);
}
.search-hero input:focus,
.toolbar input:focus {
  border-color: var(--navy);
  box-shadow: 0 0 0 4px rgba(47, 59, 189, 0.12);
}
.search-ico {
  position: absolute;
  right: 16px;
  top: 16px;
  color: var(--navy);
}

.suggest {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 6px);
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 12px;
  box-shadow: var(--shadow);
  z-index: 30;
  max-height: 360px;
  overflow: auto;
  display: none;
}
.suggest.is-open {
  display: block;
}
.suggest button {
  display: block;
  width: 100%;
  text-align: left;
  border: 0;
  background: #fff;
  padding: 11px 14px;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
}
.suggest button:hover {
  background: var(--soft);
}
.suggest .code {
  color: var(--muted);
  font-size: 12px;
  margin-left: 6px;
}
.suggest .hint {
  color: var(--navy);
  font-size: 12px;
  display: block;
  margin-top: 2px;
}

.section-label {
  margin: 8px 0 12px;
  font-size: 13px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--navy);
  font-weight: 700;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
.quick-card {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px;
  background: var(--card);
  text-decoration: none;
  color: inherit;
  min-height: 108px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  box-shadow: var(--shadow);
}
.quick-card:hover,
.svc-card:hover {
  border-color: var(--navy);
}
.quick-card strong {
  color: var(--navy-deep);
  font-size: 15px;
}
.quick-card span {
  color: var(--muted);
  font-size: 13px;
}

.toolbar {
  display: grid;
  grid-template-columns: 1fr 180px auto;
  gap: 12px;
  align-items: end;
  margin: 8px 0 14px;
}
.toolbar label {
  display: block;
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 4px;
}
.toolbar .row {
  position: relative;
}
.toolbar input {
  height: 44px;
  border-radius: 10px;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 16px;
}
.chip {
  border: 1px solid #d5d8ea;
  background: #fff;
  color: var(--navy);
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 13px;
  cursor: pointer;
  font-family: inherit;
}
.chip.is-on {
  background: var(--navy);
  color: #fff;
  border-color: var(--navy);
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 12px;
}
.pager {
  display: flex;
  gap: 4px;
  align-items: center;
}
.pager button,
.btn-ghost,
.btn-primary {
  font-family: inherit;
  cursor: pointer;
}
.pager button {
  min-width: 34px;
  height: 34px;
  border: 1px solid #d5d8ea;
  background: #fff;
  color: var(--navy);
  border-radius: 8px;
}
.pager button.is-on {
  background: var(--navy);
  color: #fff;
  border-color: var(--navy);
}
.pager button:disabled {
  opacity: 0.4;
  cursor: default;
}

.svc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 14px;
}
.svc-card {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
  min-height: 176px;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  background: var(--card);
  box-shadow: var(--shadow);
}
.svc-card:hover {
  border-color: var(--navy);
  transform: translateY(-1px);
}
.svc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.svc-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: #e8eeff;
  color: var(--navy);
  display: grid;
  place-items: center;
  margin-bottom: 8px;
}
.svc-grid .svc-card:nth-child(5n + 1) .svc-icon {
  background: #e8eeff;
  color: var(--navy);
}
.svc-grid .svc-card:nth-child(5n + 2) .svc-icon {
  background: #fff4e5;
  color: #9a6700;
}
.svc-grid .svc-card:nth-child(5n + 3) .svc-icon {
  background: #e7f6f2;
  color: #0f766e;
}
.svc-grid .svc-card:nth-child(5n + 4) .svc-icon {
  background: #eef0f8;
  color: var(--navy-deep);
}
.svc-grid .svc-card:nth-child(5n + 5) .svc-icon {
  background: #f3e8ff;
  color: #6d28d9;
}
.star {
  border: 0;
  background: transparent;
  color: #9aa0c3;
  cursor: pointer;
  font-size: 18px;
}
.star.is-on {
  color: var(--navy);
}
.svc-title {
  font-size: 16px;
  font-weight: 650;
  color: var(--navy-deep);
  margin: 0 0 6px;
}
.svc-official {
  font-size: 12.5px;
  color: var(--muted);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-top: 12px;
}
.badge {
  font-size: 11px;
  border-radius: 999px;
  padding: 3px 8px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  background: #e8eeff;
  color: var(--navy);
  border: 0;
}
.badge.need-id {
  background: #fdecea;
  color: var(--danger);
}
.badge.ecp {
  background: #fff4e5;
  color: #9a6700;
}
.badge.code {
  background: #eef0f8;
  color: var(--muted);
  font-weight: 600;
  text-transform: none;
  letter-spacing: 0;
}

.crumb {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 14px;
}
.crumb a {
  color: var(--navy);
  text-decoration: none;
}

.official-line {
  color: var(--muted);
  font-size: 14px;
  margin: 0 0 16px;
}
.result-box {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 16px 0 20px;
}
.result-item {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
  background: var(--card);
  box-shadow: var(--shadow);
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 12px;
  align-items: start;
}
.result-item:nth-child(1) {
  background: linear-gradient(180deg, #eef1ff 0%, #fff 72%);
}
.result-item:nth-child(2) {
  background: #fffaf2;
  border-color: #edd9b3;
}
.result-item:nth-child(3) {
  background: #f3fbf8;
  border-color: #c7e6dc;
}
.result-item .svc-icon {
  margin: 0;
}
.result-item small {
  display: block;
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 4px;
}
.result-item b {
  font-size: 17px;
  color: var(--navy-deep);
}
.org-line {
  margin: 0 0 22px;
}
.org-line b {
  color: var(--navy-deep);
}

.layout-2 {
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  gap: 28px;
  align-items: start;
}
.steps {
  margin: 0;
  padding: 0;
  list-style: none;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.steps li {
  display: flex;
  gap: 12px;
  margin: 0;
  padding: 14px 16px;
  border-top: 1px solid var(--line);
  align-items: flex-start;
}
.steps li:first-child {
  border-top: 0;
}
.steps .n {
  width: 28px;
  height: 28px;
  border-radius: 10px;
  background: #e8eeff;
  color: var(--navy);
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 700;
  flex: 0 0 28px;
}

.form-card,
.profile-card {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 22px;
  background: var(--card);
  box-shadow: var(--shadow);
}
.form-card h2,
.profile-card h2 {
  margin: 0 0 6px;
  font-size: 18px;
  color: var(--navy-deep);
}
.draft-bar {
  font-size: 12.5px;
  color: var(--ok);
  min-height: 18px;
  margin-bottom: 10px;
}
.field {
  margin-bottom: 12px;
}
.field label {
  display: block;
  font-size: 13px;
  margin-bottom: 4px;
  font-weight: 650;
}
.req {
  color: var(--danger);
}
.field input,
.field textarea {
  width: 100%;
  border: 1px solid #d5d8ea;
  border-radius: 10px;
  padding: 10px 12px;
  font-family: inherit;
  font-size: 15px;
  background: #fff;
}
.field input::placeholder,
.field textarea::placeholder {
  color: #9aa0c3;
}
.field textarea {
  min-height: 88px;
  resize: vertical;
}
.field input.is-bad,
.field textarea.is-bad {
  border-color: var(--danger);
  background: #fff6f6;
}
.field input.is-ok {
  border-color: #7bc49a;
}
.err {
  color: var(--danger);
  font-size: 12px;
  min-height: 16px;
  margin-top: 3px;
}
.check {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  font-size: 13.5px;
}
.actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  flex-wrap: wrap;
}
.btn-primary {
  background: var(--navy);
  color: #fff;
  border: 0;
  border-radius: 10px;
  padding: 11px 16px;
  font-weight: 650;
  text-decoration: none;
  display: inline-block;
}
.btn-ghost {
  background: #fff;
  color: var(--navy);
  border: 1px solid var(--navy);
  border-radius: 10px;
  padding: 11px 16px;
  text-decoration: none;
  display: inline-block;
}

.dl {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 0;
}
.dl div {
  display: contents;
}
.dl dt,
.dl dd {
  margin: 0;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
  font-size: 15px;
}
.dl dt {
  color: var(--muted);
}
.dl dd {
  font-weight: 600;
}
.profile-hero {
  display: flex;
  gap: 16px;
  align-items: center;
  margin: 0;
  padding: 20px 18px;
  background: linear-gradient(180deg, #eef1ff 0%, #fff 70%);
}
.avatar-lg {
  width: 64px;
  height: 64px;
  border-radius: 18px;
  background: var(--navy);
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 22px;
}
.note {
  margin-top: 18px;
  color: #7a4b00;
  font-size: 13.5px;
  background: #fffaf2;
  border: 1px solid #edd9b3;
  border-radius: 12px;
  padding: 12px 14px;
}
.profile-card {
  padding: 0;
  overflow: hidden;
}
.profile-card .dl,
.profile-card .note,
.profile-card .actions {
  margin-left: 18px;
  margin-right: 18px;
}
.profile-hero h2 {
  margin: 0 0 4px;
}
.profile-card .actions {
  margin-bottom: 18px;
}

.footer {
  background: var(--navy);
  color: rgba(255, 255, 255, 0.9);
  display: grid;
  grid-template-columns: 1.1fr 1.4fr;
  gap: 16px;
  padding: 18px 28px;
  font-size: 12px;
  line-height: 1.5;
}
.footer a {
  color: #fff;
}
.pay-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 12px;
  align-items: center;
  justify-content: flex-end;
}
.pay-chip {
  background: #fff;
  color: var(--ink);
  border-radius: 4px;
  padding: 3px 8px;
  font-weight: 800;
  font-size: 11px;
}

.hint-pop {
  position: fixed;
  z-index: 80;
  background: #1c1c28;
  color: #fff;
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 6px;
  pointer-events: none;
  max-width: 240px;
  opacity: 0;
  transform: translateY(4px);
  transition:
    opacity 0.15s,
    transform 0.15s;
}
.hint-pop.is-on {
  opacity: 1;
  transform: none;
}
.modal-back {
  position: fixed;
  inset: 0;
  background: rgba(20, 22, 60, 0.45);
  display: none;
  place-items: center;
  z-index: 50;
  padding: 24px;
}
.modal-back.is-on {
  display: grid;
}
.modal {
  background: #fff;
  border-radius: 16px;
  padding: 24px;
  max-width: 480px;
  width: 100%;
}
.modal h3 {
  margin: 0 0 8px;
  color: var(--navy-deep);
}
.muted {
  color: var(--muted);
}
.empty {
  text-align: center;
  color: var(--muted);
  padding: 40px 12px;
}

@media (max-width: 1200px) {
  .layout-2,
  .toolbar,
  .result-box,
  .dl {
    grid-template-columns: 1fr;
  }
  .dl dt {
    padding-bottom: 0;
    border: 0;
  }
}
.cat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
}
.cat-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px 16px;
  text-decoration: none;
  color: inherit;
  min-height: 156px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: var(--shadow);
}
.cat-card:hover {
  border-color: var(--navy);
  transform: translateY(-1px);
}
.cat-card .svc-icon {
  margin-bottom: 4px;
}
.cat-card:nth-child(5n + 1) .svc-icon {
  background: #e8eeff;
  color: var(--navy);
}
.cat-card:nth-child(5n + 2) .svc-icon {
  background: #fff4e5;
  color: #9a6700;
}
.cat-card:nth-child(5n + 3) .svc-icon {
  background: #e7f6f2;
  color: #0f766e;
}
.cat-card:nth-child(5n + 4) .svc-icon {
  background: #eef0f8;
  color: var(--navy-deep);
}
.cat-card:nth-child(5n + 5) .svc-icon {
  background: #f3e8ff;
  color: #6d28d9;
}
.cat-card strong {
  color: var(--navy-deep);
  font-size: 15px;
}
.cat-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}
.view-toggle {
  display: flex;
  gap: 8px;
  margin: 0 0 16px;
}
.view-toggle a {
  border-radius: 999px;
}
.fav-bar {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
  align-items: center;
  margin: 4px 0 16px;
}
.fav-search {
  max-width: none;
  margin: 0;
}
.fav-all {
  height: 52px;
  display: inline-flex;
  align-items: center;
  padding: 0 18px;
  white-space: nowrap;
}
.svc-grid-fill {
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}
.empty-fav {
  text-align: center;
  background: var(--card);
  border: 1px dashed #edd9b3;
  border-radius: 16px;
  padding: 48px 20px;
  color: var(--muted);
}
.empty-fav svg {
  width: 36px;
  height: 36px;
  color: #9a6700;
  margin-bottom: 10px;
}
.empty-fav p {
  margin: 0 0 16px;
}
.data-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--card);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.data-table th,
.data-table td {
  text-align: left;
  padding: 14px 16px;
  border-bottom: 1px solid var(--line);
  font-size: 14px;
  vertical-align: top;
}
.data-table th {
  color: var(--muted);
  font-weight: 650;
  background: #eef1ff;
  font-size: 12px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.data-table tr:last-child td {
  border-bottom: 0;
}
.data-table tbody tr:hover td {
  background: #fafbff;
}
.status {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 999px;
}
.status-done {
  background: #e6f6ec;
  color: var(--ok);
}
.status-pay {
  background: #fff4e5;
  color: #9a6700;
}
.status-draft {
  background: var(--soft);
  color: var(--muted);
}
.status-check {
  background: #e8eeff;
  color: var(--navy);
}
.status-cancel {
  background: #f4f4f5;
  color: #52525b;
}
.status-deny {
  background: #fdecea;
  color: var(--danger);
}
.tabs {
  display: flex;
  gap: 8px;
  margin: 0 0 16px;
}
.tab {
  border: 1px solid var(--line);
  background: #fff;
  border-radius: 999px;
  padding: 8px 14px;
  cursor: pointer;
  font-family: inherit;
  color: var(--navy);
}
.tab.is-on {
  background: var(--navy);
  color: #fff;
  border-color: var(--navy);
}
.mail-feed {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.mail-item {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 14px;
  padding: 16px 18px;
  border-top: 1px solid var(--line);
  margin: 0;
  background: transparent;
}
.mail-item:first-child {
  border-top: 0;
}
.mail-item.legal .news-ico {
  background: #fff4e5;
  color: #9a6700;
}
.mail-item.info .news-ico {
  background: #e8eeff;
  color: var(--navy);
}
.kind {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 999px;
  background: #eef0f8;
  color: var(--muted);
}
.mail-item.legal .kind {
  background: #fff4e5;
  color: #9a6700;
}
.mail-item.info .kind {
  background: #e8eeff;
  color: var(--navy);
}
.mail-meta {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 4px;
}
.contact-list {
  margin: 0;
  padding: 0;
  list-style: none;
}
.contact-list li {
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  display: flex;
