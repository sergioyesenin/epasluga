import { useMemo } from 'react'
import type { FamilyMember } from '../../types/service'
import { family, formatBYN, totalDue, STEM_TO_FLOWER_THRESHOLD } from '../../data/family'

type MemberPinProps = {
  member: FamilyMember
  x: number // проценты 0..100
  y: number
  selected: boolean
  onSelect: (id: string) => void
}

function MemberPin({ member, x, y, selected, onSelect }: MemberPinProps) {
  const isPaid = member.status === 'paid'
  const due = Math.max(0, member.dueAmount - member.paidAmount)
  const tint = `var(--color-family-${member.avatarTint.replace('tint-', '')})`
  const tintInk = `var(--color-family-${member.avatarTint.replace('tint-', '')}-ink)`

  return (
    <button
      type="button"
      className="family-pin absolute flex flex-col items-center gap-1 px-1"
      style={{ left: `${x}%`, top: `${y}%`, transform: 'translate(-50%, -50%)' }}
      onClick={() => onSelect(member.id)}
      aria-pressed={selected}
      aria-label={`${member.name}, ${isPaid ? 'оплачено' : `к оплате ${formatBYN(due)}`}`}
    >
      <span
        className="flex items-center justify-center w-11 h-11 rounded-full text-[13px] font-bold shadow-sm"
        style={{
          background: isPaid ? 'var(--color-family-sand)' : tint,
          color: isPaid ? 'var(--color-family-sand-ink)' : tintInk,
          opacity: isPaid ? 0.7 : 1,
        }}
        aria-hidden="true"
      >
        {member.initials}
      </span>
      <span className="text-[12.5px] font-semibold text-navy-deep leading-tight">
        {member.name.split(' ')[0]}
      </span>
      <span
        className="tabular text-[12px] leading-none"
        style={{
          color: isPaid ? 'var(--color-muted)' : 'var(--color-navy-deep)',
          fontWeight: isPaid ? 500 : 700,
        }}
      >
        {isPaid ? 'оплачено' : formatBYN(due)}
      </span>
    </button>
  )
}

/** Росток: 1–4 члена. Стебель + симметричные листья. */
function Sprout({
  members,
  selectedId,
  onSelect,
}: {
  members: FamilyMember[]
  selectedId: string | null
  onSelect: (id: string) => void
}) {
  const total = totalDue(members)
  // Листья: 4 возможных позиции на стебле
  const slots = [
    { x: 30, y: 35 }, // выше, слева
    { x: 70, y: 50 }, // выше, справа
    { x: 30, y: 65 }, // ниже, слева
    { x: 70, y: 80 }, // ниже, справа
  ]

  return (
    <div className="relative w-full max-w-105 mx-auto aspect-3/4">
      <svg
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        className="absolute inset-0 w-full h-full"
        aria-hidden="true"
      >
        {/* Стебель */}
        <path
          className="family-stem-path"
          d="M 50 96 Q 50 55 50 12"
          fill="none"
          stroke="var(--color-family-wine)"
          strokeWidth="1.2"
          strokeLinecap="round"
          opacity="0.6"
        />
        {/* Листья */}
        {members.map((_, i) => {
          const slot = slots[i % slots.length]
          const flip = slot.x < 50
          return (
            <path
              key={i}
              d={
                flip
                  ? `M 50 ${slot.y} Q 30 ${slot.y - 6} ${slot.x} ${slot.y + 2} Q 40 ${slot.y + 6} 50 ${slot.y}`
                  : `M 50 ${slot.y} Q 70 ${slot.y - 6} ${slot.x} ${slot.y + 2} Q 60 ${slot.y + 6} 50 ${slot.y}`
              }
              fill="var(--color-family-sand)"
              stroke="var(--color-family-sand-ink)"
              strokeWidth="0.6"
              opacity="0.9"
            />
          )
        })}
        {/* «Грунт» */}
        <ellipse cx="50" cy="96" rx="18" ry="2.2" fill="var(--color-family-sand)" />
      </svg>

      {members.map((m, i) => {
        const slot = slots[i % slots.length]
        return (
          <MemberPin
            key={m.id}
            member={m}
            x={slot.x}
            y={slot.y}
            selected={selectedId === m.id}
            onSelect={onSelect}
          />
        )
      })}

      {/* Итог в «грунте» */}
      <div className="absolute left-1/2 -translate-x-1/2 bottom-0 flex flex-col items-center pb-2">
        <span className="text-[12.5px] text-muted">К оплате у семьи</span>
        <span
          className="tabular text-[clamp(28px,5vw,40px)] font-bold leading-none"
          style={{ color: 'var(--color-family-wine)' }}
        >
          {formatBYN(total)}
        </span>
      </div>
    </div>
  )
}

/** Цветок: 5+ членов. Сердцевина + лепестки по кругу. */
function Flower({
  members,
  selectedId,
  onSelect,
}: {
  members: FamilyMember[]
  selectedId: string | null
  onSelect: (id: string) => void
}) {
  const total = totalDue(members)
  const n = members.length
  const cx = 50
  const cy = 50
  const R = n <= 6 ? 34 : 40 // радиус до центра лепестка
  const petalW = n <= 6 ? 18 : 14
  const petalH = n <= 6 ? 26 : 22

  const positions = useMemo(
    () =>
      members.map((_, i) => {
        const angle = -Math.PI / 2 + (i * 2 * Math.PI) / n
        return {
          x: cx + R * Math.cos(angle),
          y: cy + R * Math.sin(angle),
          angleDeg: (angle * 180) / Math.PI,
        }
      }),
    [members, n, R, cx, cy],
  )

  return (
    <div className="relative w-full max-w-140 mx-auto aspect-square">
      <svg
        viewBox="0 0 100 100"
        className="absolute inset-0 w-full h-full"
        aria-hidden="true"
      >
        {positions.map((p, i) => (
          <g
            key={i}
            transform={`translate(${p.x} ${p.y}) rotate(${p.angleDeg + 90})`}
          >
            <ellipse
              cx="0"
              cy="0"
              rx={petalW / 2}
              ry={petalH / 2}
              fill="var(--color-family-sand)"
              stroke="var(--color-family-sand-ink)"
              strokeWidth="0.5"
            />
          </g>
        ))}
        {/* Сердцевина */}
        <circle
          cx={cx}
          cy={cy}
          r={n <= 6 ? 16 : 14}
          fill="var(--color-family-wine-tint)"
          stroke="var(--color-family-wine)"
          strokeWidth="0.6"
        />
      </svg>

      {positions.map((p, i) => (
        <MemberPin
          key={members[i].id}
          member={members[i]}
          x={p.x}
          y={p.y}
          selected={selectedId === members[i].id}
          onSelect={onSelect}
        />
      ))}

      {/* Сумма в сердцевине */}
      <div className="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center pointer-events-none">
        <span className="text-[10.5px] uppercase tracking-wider text-family-wine-ink font-semibold">
          К оплате
        </span>
        <span
          className="tabular text-[clamp(16px,3vw,24px)] font-bold leading-none"
          style={{ color: 'var(--color-family-wine)' }}
        >
          {formatBYN(total)}
        </span>
      </div>
    </div>
  )
}

export type FamilyOverviewProps = {
  members?: FamilyMember[]
  selectedId: string | null
  onSelect: (id: string) => void
}

export function FamilyOverview({
  members = family,
  selectedId,
  onSelect,
}: FamilyOverviewProps) {
  const isFlower = members.length >= STEM_TO_FLOWER_THRESHOLD
  return (
    <div
      className="family-flower"
      data-dim={selectedId ? 'true' : 'false'}
      role="group"
      aria-label={`Семья: ${members.length} человек, к оплате ${formatBYN(totalDue(members))}`}
    >
      {isFlower ? (
        <Flower members={members} selectedId={selectedId} onSelect={onSelect} />
      ) : (
        <Sprout members={members} selectedId={selectedId} onSelect={onSelect} />
      )}
      <p className="mt-4 text-center text-[12.5px] text-muted">
        {isFlower
          ? 'Число лепестков = число членов семьи. Насыщенность — оплачено ли.'
          : 'Росток растёт вместе с семьёй. Начиная с 5 человек — расцветает.'}
      </p>
    </div>
  )
}
