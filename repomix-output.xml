                  <ClockIcon className="w-4 h-4" />
                </span>
                <div className="min-w-0">
                  <div className="font-semibold text-navy-deep truncate">{n.title}</div>
                  <div className="text-xs text-muted">{formatWhen(n.at)}</div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </Card>
    </div>
  )
}
